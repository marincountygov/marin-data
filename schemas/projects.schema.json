{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marin projects and campaigns",
  "type": "object",
  "required": ["schemaVersion", "projects"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "title": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Permanent. Never reuse or rename." },
          "name": { "type": "string", "description": "What people see in every app." },
          "links": {
            "type": "object",
            "description": "Shows the project as a campaign in Marin Links.",
            "required": ["code", "legacy"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "pattern": "^cmp-[0-9]{2,}$", "description": "Sent in a link. Permanent." },
              "legacy": { "type": "array", "items": { "type": "string" }, "description": "Older values that mean the same project." }
            }
          },
          "reach": { "const": true, "description": "Shows the project in the Project filter in Marin Reach, even with no engagements." },
          "mentions": {
            "type": "object",
            "description": "Marin Mentions watches for these phrases.",
            "required": ["include"],
            "additionalProperties": false,
            "properties": {
              "include": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "exclude": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
