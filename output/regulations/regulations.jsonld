      ],
      "name": "Compensation",
      "description": "This Personnel Management Regulation (PMR) describes compensation policies for County employees.",
      "version": "0",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "local:pmr-effective-date-as-written",
          "value": "2005-01"
        },
        {
          "@type": "PropertyValue",
