    },
    {
      "@id": "https://marincountygov.github.io/marin-data/id/regulation/pmr-21/21.6",
      "@type": "Legislation",
      "legislationIdentifier": "21.6",
      "name": "External Complaint",
      "codificationLevel": "section",
      "position": 6,
      "isPartOf": {
        "@id": "https://marincountygov.github.io/marin-data/id/regulation/pmr-21"
      },
      "text": "A. The Human Resources Department will make available upon request information from the Department of Fair Employment and Housing and/or the Equal Employment Opportunity Commission regarding filing claims of equal employment opportunity violations, harassment, or retaliation with these entities.\n\nB. The County’s obligation to defend and indemnify its officers and employees is prescribed by California Government Code Sections 825 et seq. and 995 et seq. For allegations of harassment filed against a County employee in a court of law or other appropriate outside governmental agency, the determination to provide the employee with legal representation and/or pay the cost of settlement or judgment will be made consistent with all applicable requirements of the California Government Code including but not limited to those listed above.",
      "legislationType": "regulation"
    },
    {
      "@id": "https://marincountygov.github.io/marin-data/id/regulation/pmr-22",
