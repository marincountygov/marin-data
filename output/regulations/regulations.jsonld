      ],
      "name": "Leaves of Absence",
      "description": "This Personnel Management Regulation (PMR) presents rules for the various types of leaves of absence applicable to County employees.",
      "version": "0",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "local:pmr-effective-date-as-written",
          "value": "2026-04"
        },
        {
          "@type": "PropertyValue",
