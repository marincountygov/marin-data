        },
        {
          "@id": "https://marincountygov.github.io/marin-data/id/regulation/pmr-42/42.2"
        },
        {
          "@id": "https://marincountygov.github.io/marin-data/id/regulation/pmr-42/42.3"
        },
        {
          "@id": "https://marincountygov.github.io/marin-data/id/regulation/pmr-42/42.4"
        },
        {
          "@id": "https://marincountygov.github.io/marin-data/id/regulation/pmr-42/42.5"
        },
        {
          "@id": "https://marincountygov.github.io/marin-data/id/regulation/pmr-42/42.6"
        },
        {
          "@id": "https://marincountygov.github.io/marin-data/id/regulation/pmr-42/42.7"
        },
        {
          "@id": "https://marincountygov.github.io/marin-data/id/regulation/pmr-42/42.8"
        },
        {
          "@id": "https://marincountygov.github.io/marin-data/id/regulation/pmr-42/42.9"
        },
        {
