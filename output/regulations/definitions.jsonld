        }
      ]
    },
    {
      "@id": "https://marincountygov.github.io/marin-data/id/term/pmr/probationary-period",
      "@type": "DefinedTerm",
      "name": "Probationary Period",
      "description": "A trial period during which an employee in the Merit System is required to demonstrate competency in the knowledge, skills and abilities necessary to successfully perform the job and from which an employee may be released without cause or right of appeal. The probationary period is the final step in the examination process.",
      "position": 22,
      "inDefinedTermSet": {
        "@id": "https://marincountygov.github.io/marin-data/id/term-set/personnel-management-regulations"
      },
      "subjectOf": [
        {
          "@id": "https://marincountygov.github.io/marin-data/id/regulation/pmr-2/2.1"
        }
      ]
    },
    {
      "@id": "https://marincountygov.github.io/marin-data/id/term/pmr/promotion",
      "@type": "DefinedTerm",
      "name": "Promotion",
      "description": "Advancement of an employee from a position in an established classification to a position in an established classification with higher level duties and responsibilities, higher qualifications and a higher maximum salary.",
      "position": 23,
      "inDefinedTermSet": {
        "@id": "https://marincountygov.github.io/marin-data/id/term-set/personnel-management-regulations"
      },
      "subjectOf": [
        {
          "@id": "https://marincountygov.github.io/marin-data/id/regulation/pmr-2/2.1"
        }
      ]
    },
    {
      "@id": "https://marincountygov.github.io/marin-data/id/term/pmr/reassignment",
      "@type": "DefinedTerm",
      "name": "Reassignment",
      "description": "A move of an employee from one division or budget center to another within the same department in the same or similar classification at the same rate of pay.",
      "position": 24,
      "inDefinedTermSet": {
        "@id": "https://marincountygov.github.io/marin-data/id/term-set/personnel-management-regulations"
      },
      "subjectOf": [
        {
          "@id": "https://marincountygov.github.io/marin-data/id/regulation/pmr-2/2.1"
        }
      ]
    },
    {
      "@id": "https://marincountygov.github.io/marin-data/id/term/pmr/reclassification",
      "@type": "DefinedTerm",
      "name": "Reclassification",
      "description": "A reallocation of a position and the incumbent, if applicable, to a different or new classification because of a significant change in duties and/or responsibility of the position over time.",
      "position": 25,
      "inDefinedTermSet": {
        "@id": "https://marincountygov.github.io/marin-data/id/term-set/personnel-management-regulations"
      },
      "subjectOf": [
