      "@id": "https://marincountygov.github.io/marin-data/id/term/pmr/reinstatement",
      "@type": "DefinedTerm",
      "name": "Reinstatement",
      "description": "A return to employment of an employee following leave without pay, upon reemployment following layoff, or return within 60 days of resignation.",
      "position": 26,
      "inDefinedTermSet": {
        "@id": "https://marincountygov.github.io/marin-data/id/term-set/personnel-management-regulations"
