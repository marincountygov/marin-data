    {
      "@id": "https://marincountygov.github.io/marin-data/id/term/pmr/exempt-employee",
      "@type": "DefinedTerm",
      "name": "Exempt Employee",
      "description": "An employee defined under federal law as not subject to overtime payment over 40 hours per week or the equivalent. Also known under federal law as a salaried employee.",
      "position": 18,
      "inDefinedTermSet": {
        "@id": "https://marincountygov.github.io/marin-data/id/term-set/personnel-management-regulations"
